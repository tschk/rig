#!/usr/bin/env bash
# Fast reconnect: ensure cargo/rustc are on PATH after orb wake.
set -euo pipefail

export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
export RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"
export PATH="$CARGO_HOME/bin:$PATH"

if [[ -f "$CARGO_HOME/env" ]]; then
  # shellcheck disable=SC1091
  source "$CARGO_HOME/env"
fi

if ! command -v rustc >/dev/null 2>&1 || ! command -v cargo >/dev/null 2>&1; then
  echo "resume: rustc/cargo missing — run .agents/setup" >&2
  exit 1
fi

# Ensure a login-shell PATH includes cargo (Amp services use non-interactive login shells).
profile="$HOME/.bash_profile"
marker="# rig cargo PATH"
if [[ ! -f "$profile" ]] || ! grep -Fqx "$marker" "$profile" 2>/dev/null; then
  {
    echo
    echo "$marker"
    echo 'export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"'
    echo 'export RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"'
    echo 'export PATH="$CARGO_HOME/bin:$PATH"'
    echo '[[ -f "$CARGO_HOME/env" ]] && . "$CARGO_HOME/env"'
  } >> "$profile"
fi

command -v rustc >/dev/null
command -v cargo >/dev/null
